{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "studyshelf",
	"account_id": "0754869b5f2ec03f00cf4abb42847406",
	"main": "./worker.js",
	"compatibility_date": "2026-10-15",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "studyshelf-db",
			"database_id": "5b470f68-e347-4a63-b538-76477e1aeb51",
			"migrations_dir": "migrations"
		}
	]
}
